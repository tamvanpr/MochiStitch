<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MochiStitch" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/launcher_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.MochiStitch.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launcher_bg</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MochiStitch</item>
    </style>
</resources>
